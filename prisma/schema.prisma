datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String      @id @default(cuid())
  idNumber      String      @unique
  fullName      String
  email         String      @unique
  username      String      @unique
  country       String
  passwordHash  String   
  createdAt   DateTime    @default(now())
  wallet      Wallet?
  orders         Order[]
}

model Wallet{
  id          String       @id @default(cuid())
  userId      String       @unique
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId] , references:[id]) 
  balances    WalletBalance[]
}

model WalletBalance {
  id         String       @id @default(cuid())
  walletId   String
  currency   Currency
  available Decimal  @default(0)
  locked    Decimal  @default(0)
  wallet     Wallet       @relation(fields:[walletId],references:[id])

  @@unique([walletId,currency])
  @@index([walletId])

}

model Trade {
  id           String   @id @default(cuid())
  buyOrderId   String
  sellOrderId  String

  pair         CoinPair
  price        Decimal
  quantity     Decimal

  executedAt   DateTime @default(now())

  buyOrder     Order    @relation("BuyTrades", fields:[buyOrderId], references:[id])
  sellOrder    Order    @relation("SellTrades", fields:[sellOrderId], references:[id])

  @@index([pair, executedAt])
  @@index([buyOrderId])
  @@index([sellOrderId])
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  OPEN
  PROCESSING
  CANCELLED
  FILLED
  PARTIALLY_FILLED
}

enum CoinPair {
  BTC_USDT
  ETH_USDT
}

enum Currency {
  USDT
  BTC
  ETH
}

model Order {
  id         String    @id @default(cuid())
  userId     String
  pair       CoinPair
  side       OrderSide
  status     OrderStatus @default(OPEN)
  price      Decimal
  quantity   Decimal
  filledQuantity Decimal @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields:[userId], references:[id])

  buyTrades  Trade[]   @relation("BuyTrades")
  sellTrades Trade[]   @relation("SellTrades")
  
  @@index([userId,status])
  @@index([pair,status,side])
}


generator erd {
  provider = "prisma-erd-generator"
  output   = "./ERD.svg"
}